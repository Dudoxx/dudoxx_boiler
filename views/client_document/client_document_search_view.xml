<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dudoxx_boiler_client_document_search" model="ir.ui.view">
        <field name="name">dudoxx_boiler.client_document.search</field>
        <field name="model">dudoxx_boiler.client_document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('file_name', 'ilike', self)]"/>
                <field name="document_type"/>
                <field name="client_ids"/>
                <field name="date"/>

                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                ('date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>

                <group name="group_by">
                    <filter string="Document Type" name="group_by_document_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Month" name="group_by_month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
