<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Window Action -->
    <record id="action_dudoxx_boiler_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dudoxx_boiler.client</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_dudoxx_boiler_client_search"/>
        <field name="context">{
            'search_default_active_status': 1,
            'search_default_group_by_status': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first client
            </p>
            <p>
                Create and manage your clients. Track their documents,
                contact information, and business relationships.
            </p>
        </field>
    </record>

    <!-- Views Specific to Action -->
    <record id="action_dudoxx_boiler_client_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_dudoxx_boiler_client_kanban"/>
        <field name="act_window_id" ref="action_dudoxx_boiler_client"/>
    </record>

    <record id="action_dudoxx_boiler_client_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_dudoxx_boiler_client_tree"/>
        <field name="act_window_id" ref="action_dudoxx_boiler_client"/>
    </record>

    <record id="action_dudoxx_boiler_client_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dudoxx_boiler_client_form"/>
        <field name="act_window_id" ref="action_dudoxx_boiler_client"/>
    </record>
</odoo>
